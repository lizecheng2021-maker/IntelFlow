# === AI Model (pick at least one) ===
# IntelFlow works with any LLM. Configure whichever you prefer.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ZHIPU_API_KEY=
# DASHSCOPE_API_KEY=        # Alibaba Qwen (通义千问)

# === Web Search (optional, improves coverage) ===
# Add any search API to supplement data collection.
# Configure additional data source keys in the Web UI (http://localhost:5000).

# === Publishing (optional) ===
# WORDPRESS_URL=https://your-site.com
# WORDPRESS_USER=admin
# WORDPRESS_APP_PASSWORD=
# FEISHU_WEBHOOK=

# Social Media Publishing (Optional)
# Twitter/X — OAuth 1.0a credentials from developer.twitter.com
# Also set twitter.enabled=true in config/platforms.json
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn — OAuth 2.0 token with w_member_social scope
# Person URN: GET https://api.linkedin.com/v2/userinfo → "sub" field
# Also set linkedin.enabled=true in config/platforms.json
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID
